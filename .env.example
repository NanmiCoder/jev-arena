# Node.js 22+；复制为 .env，或在网页设置中填写（网页配置仅保存在内存）
HOST=127.0.0.1
PORT=5173
DATA_PATH=examples/comments.csv
LEFT_LABEL=Jev
LEFT_PROTOCOL=jev
LEFT_BASE_URL=https://openrouter.ai/api
